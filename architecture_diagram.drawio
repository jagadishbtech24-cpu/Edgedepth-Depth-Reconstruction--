<mxfile host="app.diagrams.net" modified="2026-11-07T03:06:25+00:00" agent="EdgeDepth architecture generator" version="24.7.17" type="device"><diagram id="edgedepth-pipeline" name="Architecture"><mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="EdgeDepth Architecture - RGB-Guided Depth Reconstruction" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontSize=28;fontStyle=1;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="300" y="35" width="1900" height="55" as="geometry" /></mxCell><mxCell id="subtitle" value="Implemented data paths from the EdgeDepth source code" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontSize=17;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="500" y="90" width="1500" height="36" as="geometry" /></mxCell><mxCell id="rgb" value="&lt;b&gt;RGB IMAGE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Registered color input" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=16;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="260" height="140" as="geometry" /></mxCell><mxCell id="depth" value="&lt;b&gt;SPARSE DEPTH MAP&lt;/b&gt;&lt;br&gt;&lt;br&gt;Low-resolution or sparse depth&lt;br&gt;Binary validity mask" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=16;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="260" height="150" as="geometry" /></mxCell><mxCell id="reference" value="&lt;b&gt;REFERENCE DEPTH&lt;/b&gt;&lt;br&gt;&lt;br&gt;Optional registered ground truth&lt;br&gt;Enables metric evaluation" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=16;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="260" height="120" as="geometry" /></mxCell><mxCell id="prepare" value="&lt;b&gt;INPUT AND DEPTH PREPARATION&lt;/b&gt;&lt;br&gt;&lt;br&gt;Validate RGB-depth alignment&lt;br&gt;Choose sensor depth or&lt;br&gt;downsample reference&lt;br&gt;Sampling factor: 2x, 4x, or 8x&lt;br&gt;Optional noise, sparsity, and sensor holes&lt;br&gt;Carry the valid-depth mask" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=16;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="390" y="320" width="320" height="280" as="geometry" /></mxCell><mxCell id="classical" value="&lt;b&gt;CLASSICAL COMPARISONS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Nearest, Bilinear, Bicubic&lt;br&gt;Bicubic + RGB: Guided filter&lt;br&gt;Bicubic + RGB: Joint bilateral filter&lt;br&gt;Each produces a depth prediction" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=16;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="805" y="170" width="440" height="270" as="geometry" /></mxCell><mxCell id="edgeguide" value="&lt;b&gt;EDGEGUIDENET&lt;/b&gt;&lt;br&gt;&lt;br&gt;RGB + prepared depth and mask&lt;br&gt;Residual depth prediction&lt;br&gt;Boundary-confidence output" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=16;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="805" y="520" width="440" height="200" as="geometry" /></mxCell><mxCell id="depthunet" value="&lt;b&gt;DEPTHUNET - SEPARATE MODEL&lt;/b&gt;&lt;br&gt;&lt;br&gt;RGB + sparse depth / 10 + binary mask&lt;br&gt;Five-channel input at 240 x 320&lt;br&gt;Strictly loaded supplied checkpoint&lt;br&gt;Independent metric-depth prediction" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=16;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="805" y="850" width="440" height="225" as="geometry" /></mxCell><mxCell id="hybrid" value="&lt;b&gt;HYBRID REFINEMENT&lt;/b&gt;&lt;br&gt;&lt;br&gt;EdgeGuideNet depth + registered RGB&lt;br&gt;Heuristic RGB/depth affinity&lt;br&gt;Guided or joint bilateral filter&lt;br&gt;Optional boundary-aware sharpening" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=16;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1320" y="520" width="360" height="235" as="geometry" /></mxCell><mxCell id="evaluation" value="&lt;b&gt;EVALUATION&lt;/b&gt;&lt;br&gt;&lt;br&gt;Compare each prediction with reference&lt;br&gt;RMSE, MAE, PSNR, SSIM, AbsRel&lt;br&gt;Delta accuracy and Edge RMSE&lt;br&gt;Boundary precision, recall, and F1&lt;br&gt;Per-method latency" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=16;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1760" y="490" width="360" height="300" as="geometry" /></mxCell><mxCell id="outputs" value="&lt;b&gt;RESULT VIEWS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Depth map per method&lt;br&gt;Boundary overlays&lt;br&gt;Error maps with reference&lt;br&gt;Approximate 3D surfaces&lt;br&gt;Depth array export" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=16;fontFamily=Arial;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="2180" y="490" width="260" height="300" as="geometry" /></mxCell><mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.35714285714285715;fontColor=#000000;fontSize=14;fontFamily=Arial;" edge="1" parent="1" source="rgb" target="prepare"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="355" y="240" /><mxPoint x="355" y="420" /></Array></mxGeometry></mxCell><mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5535714285714286;fontColor=#000000;fontSize=14;fontFamily=Arial;" edge="1" parent="1" source="depth" target="prepare"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="355" y="475" /></Array></mxGeometry></mxCell><mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1.0;exitY=0.2857142857142857;entryX=0.0;entryY=0.5;fontColor=#000000;fontSize=14;fontFamily=Arial;" edge="1" parent="1" source="prepare" target="classical"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="755" y="400" /><mxPoint x="755" y="305" /></Array></mxGeometry></mxCell><mxCell id="edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1.0;exitY=0.48214285714285715;entryX=0.0;entryY=0.5;fontColor=#000000;fontSize=14;fontFamily=Arial;" edge="1" parent="1" source="prepare" target="edgeguide"><mxGeometry relative="1" as